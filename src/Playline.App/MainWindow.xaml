<Window x:Class="Playline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Playline.App.Controls"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        mc:Ignorable="d"
        automation:AutomationProperties.Name="Playline"
        Title="Playline"
        Width="238"
        Height="68"
        MinWidth="190"
        MinHeight="58"
        MaxWidth="600"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        SnapsToDevicePixels="False"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="HorizontalGamesPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="VerticalGamesPanel">
            <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Border x:Name="WindowChrome"
            Margin="5"
            Padding="0"
            Background="{StaticResource PlaylineWindowBrush}"
            BorderBrush="{StaticResource PlaylineBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            MouseLeftButtonDown="WindowChrome_MouseLeftButtonDown"
            SnapsToDevicePixels="False">
        <Border.Effect>
            <DropShadowEffect BlurRadius="9"
                              Direction="270"
                              Opacity="0.34"
                              ShadowDepth="1"
                              Color="#FF000000" />
        </Border.Effect>
        <Grid>
            <Border Margin="1"
                    Background="{StaticResource PlaylineDiagonalSheenBrush}"
                    CornerRadius="13"
                    IsHitTestVisible="False"
                    Opacity="0.58" />
            <Border Margin="1"
                    Background="{StaticResource PlaylinePanelSheenBrush}"
                    CornerRadius="13"
                    IsHitTestVisible="False"
                    Opacity="0.48" />
            <Border Margin="1"
                    Background="{StaticResource PlaylineGlassGlowBrush}"
                    BorderBrush="{StaticResource PlaylineInnerBorderBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="13"
                    IsHitTestVisible="False" />
            <Border Margin="1"
                    BorderBrush="{StaticResource PlaylineLowerRimBrush}"
                    BorderThickness="0,0,1,1"
                    CornerRadius="13"
                    IsHitTestVisible="False" />

            <Grid x:Name="LayoutRoot"
                  Margin="6,4"
                  KeyboardNavigation.TabNavigation="Cycle">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="GamesRow" Height="*" />
                    <RowDefinition x:Name="MenuRow" Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="GamesColumn" Width="*" />
                    <ColumnDefinition x:Name="MenuColumn" Width="Auto" />
                </Grid.ColumnDefinitions>

            <Grid x:Name="GamesHost"
                  Grid.Row="0"
                  Grid.Column="0"
                  ClipToBounds="True">
                <ScrollViewer x:Name="GamesScrollViewer"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="HorizontalOnly"
                              PreviewMouseWheel="GamesScrollViewer_PreviewMouseWheel">
                    <ItemsControl x:Name="GamesItemsControl"
                                  automation:AutomationProperties.Name="Jogos"
                                  ItemsPanel="{StaticResource HorizontalGamesPanel}"
                                  Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:GameItem Game="{Binding}"
                                                   DisplayMode="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   ItemSize="{Binding ItemSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   BarOrientation="{Binding BarOrientation, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   OpenRequested="GameItem_OpenRequested"
                                                   EditRequested="GameItem_EditRequested"
                                                   FavoriteRequested="GameItem_FavoriteRequested"
                                                   MoveLeftRequested="GameItem_MoveLeftRequested"
                                                   MoveRightRequested="GameItem_MoveRightRequested"
                                                   ReorderRequested="GameItem_ReorderRequested"
                                                   RemoveRequested="GameItem_RemoveRequested" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid x:Name="EmptyStatePanel"
                      Background="Transparent">
                    <StackPanel x:Name="EmptyStateContent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock x:Name="EmptyStateText"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PlaylineSecondaryTextBrush}"
                                   FontSize="13"
                                   Text="Nenhum jogo adicionado" />
                        <Button x:Name="EmptyAddButton"
                                Margin="8,0,0,0"
                                Content="+ Adicionar"
                                Style="{StaticResource PlaylineTextButtonStyle}"
                                automation:AutomationProperties.AutomationId="EmptyAddGameButton"
                                automation:AutomationProperties.Name="Adicionar jogo"
                                Click="AddGame_Click" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Button x:Name="MenuButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource PlaylineMenuButtonStyle}"
                    ToolTip="Mais opções"
                    automation:AutomationProperties.AutomationId="OverflowMenuButton"
                    automation:AutomationProperties.Name="Mais opções"
                    PreviewMouseLeftButtonDown="MenuButton_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="MenuButton_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="MenuButton_PreviewMouseLeftButtonUp"
                    Click="MenuButton_Click">
                <Button.ContextMenu>
                    <ContextMenu x:Name="OverflowMenu"
                                 Placement="Bottom"
                                 HorizontalOffset="-116"
                                 VerticalOffset="4"
                                 Style="{StaticResource PlaylineContextMenuStyle}"
                                 PreviewKeyDown="OverflowMenu_PreviewKeyDown">
                        <MenuItem Header="Procurar jogo no computador"
                                  Style="{StaticResource PlaylineMenuItemStyle}"
                                  automation:AutomationProperties.AutomationId="AddGameMenuItem"
                                  Click="AddGame_Click" />
                        <MenuItem Header="Detectar Steam e Epic"
                                  Style="{StaticResource PlaylineMenuItemStyle}"
                                  automation:AutomationProperties.AutomationId="DiscoverGamesMenuItem"
                                  Click="DiscoverGames_Click" />
                        <Separator Style="{StaticResource PlaylineSeparatorStyle}" />
                        <MenuItem x:Name="LockPositionMenuItem"
                                  Header="Fixar posição"
                                  IsCheckable="True"
                                  Style="{StaticResource PlaylineMenuItemStyle}"
                                  automation:AutomationProperties.AutomationId="LockPositionMenuItem"
                                  Click="LockPositionMenuItem_Click" />
                        <MenuItem Header="Centralizar horizontalmente"
                                  Style="{StaticResource PlaylineMenuItemStyle}"
                                  automation:AutomationProperties.AutomationId="CenterBarMenuItem"
                                  Click="CenterBarMenuItem_Click" />
                        <MenuItem Header="Configurações"
                                  Style="{StaticResource PlaylineMenuItemStyle}"
                                  automation:AutomationProperties.AutomationId="SettingsMenuItem"
                                  Click="SettingsMenuItem_Click" />
                        <Separator Style="{StaticResource PlaylineSeparatorStyle}" />
                        <MenuItem Header="Sair"
                                  InputGestureText="Ctrl+Q"
                                  Style="{StaticResource PlaylineMenuItemStyle}"
                                  automation:AutomationProperties.AutomationId="ExitMenuItem"
                                  Click="ExitMenuItem_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Ellipse Width="3.5"
                             Height="3.5"
                             Margin="2,0"
                             Fill="{StaticResource PlaylineMenuDotBrush}" />
                    <Ellipse Width="3.5"
                             Height="3.5"
                             Margin="2,0"
                             Fill="{StaticResource PlaylineMenuDotBrush}" />
                    <Ellipse Width="3.5"
                             Height="3.5"
                             Margin="2,0"
                             Fill="{StaticResource PlaylineMenuDotBrush}" />
                </StackPanel>
            </Button>

            <Border x:Name="StatusBanner"
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="2"
                    Panel.ZIndex="20"
                    MaxWidth="430"
                    Padding="12,7"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource PlaylineSurfaceBrush}"
                    BorderBrush="{StaticResource PlaylineBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource PlaylineTextBrush}"
                           FontSize="12"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
